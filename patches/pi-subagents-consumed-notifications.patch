diff --git a/test/completion-delivery.test.ts b/test/completion-delivery.test.ts
new file mode 100644
index 0000000..859d707
--- /dev/null
+++ b/test/completion-delivery.test.ts
@@ -0,0 +1,236 @@
+import type { Context } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { agentCall, runPrintMode, type ManagerHandle, type PrintModeRun } from "./helpers/print-mode-runner.js";
+
+vi.setConfig({ testTimeout: 30_000 });
+
+function manager() {
+  const value = (globalThis as Record<symbol, unknown>)[Symbol.for("pi-subagents:manager")] as ManagerHandle | undefined;
+  if (!value) throw new Error("Subagent manager was not loaded");
+  return value;
+}
+
+function isParent(context: Context) {
+  return context.messages.some(message => message.role === "system" && message.toolsAdded?.some(tool => tool.name === "Agent"));
+}
+
+function spawnedIds(context: Context) {
+  return context.messages.flatMap(message => {
+    if (message.role !== "toolResult" || message.toolName !== "Agent") return [];
+    const text = message.content.flatMap(part => part.type === "text" ? [part.text] : []).join("\n");
+    const id = /Agent ID: (\S+)/.exec(text)?.[1];
+    return id ? [id] : [];
+  });
+}
+
+function deferred() {
+  let resolve = () => {};
+  const promise = new Promise<void>(done => { resolve = done; });
+  return { promise, resolve };
+}
+
+function assistantTexts(run: PrintModeRun) {
+  return run.parentSession.messages.flatMap(message => message.role === "assistant"
+    ? message.content.flatMap(part => part.type === "text" ? [part.text] : [])
+    : []);
+}
+
+function notifications(run: PrintModeRun) {
+  return run.parentSession.messages.filter(message => message.role === "custom" && message.customType === "subagent-notification");
+}
+
+describe("completion delivery through the real Pi loop", () => {
+  let run: PrintModeRun | undefined;
+
+  afterEach(async () => {
+    await run?.dispose();
+    run = undefined;
+    vi.useRealTimers();
+  });
+
+  it("does not replay a notification after the parent retrieved the completed result", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Delegate, read the result, then finish.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) return "CHILD_RESULT";
+        parentCalls++;
+        const ids = spawnedIds(context);
+        if (ids.length === 0) return agentCall({ prompt: "Review.", description: "review", run_in_background: true });
+        if (!context.messages.some(message => message.role === "toolResult" && message.toolName === "get_subagent_result")) {
+          await manager().waitForAll();
+          // Expire both the 100 ms spawn batch and the 200 ms notification hold
+          // while the parent is still in a model request, before it reads the result.
+          await vi.advanceTimersByTimeAsync(400);
+          return fauxToolCall("get_subagent_result", { agent_id: ids[0], wait: true });
+        }
+        return context.messages.some(message => message.role === "user" && JSON.stringify(message.content).includes("task-notification"))
+          ? "Already accounted for."
+          : "FULL_FINAL_ANSWER";
+      },
+    });
+
+    expect(parentCalls).toBe(3);
+    expect(assistantTexts(run)).toEqual(["FULL_FINAL_ANSWER"]);
+    expect(notifications(run)).toEqual([]);
+  });
+
+  it("delivers an unread result before the next response instead of after the final answer", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Delegate and incorporate the result.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) return "CHILD_RESULT";
+        parentCalls++;
+        const ids = spawnedIds(context);
+        if (ids.length === 0) return agentCall({ prompt: "Review.", description: "review", run_in_background: true });
+        if (parentCalls === 2) {
+          await manager().waitForAll();
+          await vi.advanceTimersByTimeAsync(400);
+          return fauxToolCall("get_subagent_result", { agent_id: "unknown-agent" });
+        }
+        return JSON.stringify(context.messages).includes("CHILD_RESULT") ? "FINAL_WITH_CHILD_RESULT" : "RESULT_MISSING";
+      },
+    });
+
+    expect(parentCalls).toBe(3);
+    expect(assistantTexts(run)).toEqual(["FINAL_WITH_CHILD_RESULT"]);
+    expect(notifications(run)).toHaveLength(1);
+  });
+
+  it.each([false, true])("filters consumed members from a grouped completion, all consumed: %s", async consumeAll => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Delegate two reviews and read their results.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) return "CHILD_RESULT";
+        parentCalls++;
+        const ids = spawnedIds(context);
+        if (ids.length === 0) return [
+          agentCall({ prompt: "Review one.", description: "one", name: "first", run_in_background: true }, { id: "spawn-one" }),
+          agentCall({ prompt: "Review two.", description: "two", name: "second", run_in_background: true }, { id: "spawn-two" }),
+        ];
+        if (parentCalls === 2) {
+          await manager().waitForAll();
+          await vi.advanceTimersByTimeAsync(400);
+          // The handle must consume the same pending notification as the id.
+          return consumeAll
+            ? [fauxToolCall("get_subagent_result", { agent_id: "first" }, { id: "read-one" }),
+                fauxToolCall("get_subagent_result", { agent_id: "second" }, { id: "read-two" })]
+            : fauxToolCall("get_subagent_result", { agent_id: "first" });
+        }
+        return "FULL_FINAL_ANSWER";
+      },
+    });
+
+    expect(parentCalls).toBe(3);
+    expect(assistantTexts(run)).toEqual(["FULL_FINAL_ANSWER"]);
+    const received = notifications(run);
+    expect(received).toHaveLength(consumeAll ? 0 : 1);
+    if (!consumeAll) {
+      expect(JSON.stringify(received[0])).not.toContain('"description":"one"');
+      const details = received[0].role === "custom" ? received[0].details : undefined;
+      expect(details).toMatchObject({ description: "two" });
+    }
+  });
+
+  it("does not deliver an old completion after the same agent is resumed", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Run two reviews with the same agent, then read the result.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) return JSON.stringify(context.messages).includes("Second review.") ? "SECOND_RESULT" : "FIRST_RESULT";
+        parentCalls++;
+        const id = spawnedIds(context)[0];
+        if (!id) return agentCall({ prompt: "First review.", description: "review", run_in_background: true });
+        if (parentCalls === 2) {
+          await manager().waitForAll();
+          await vi.advanceTimersByTimeAsync(400);
+          return agentCall({ prompt: "Second review.", description: "review", resume: id, run_in_background: true });
+        }
+        if (parentCalls === 3) {
+          await manager().waitForAll();
+          await vi.advanceTimersByTimeAsync(400);
+          return fauxToolCall("get_subagent_result", { agent_id: id, wait: true });
+        }
+        return "FULL_FINAL_ANSWER";
+      },
+    });
+
+    expect(parentCalls).toBe(4);
+    expect(assistantTexts(run)).toEqual(["FULL_FINAL_ANSWER"]);
+    expect(notifications(run)).toEqual([]);
+  });
+
+  it("still wakes an idle parent for a genuinely unread result", async () => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const child = deferred();
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Start a background review.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) { await child.promise; return "CHILD_RESULT"; }
+        parentCalls++;
+        if (spawnedIds(context).length === 0) return agentCall({ prompt: "Review.", description: "review", run_in_background: true });
+        return JSON.stringify(context.messages).includes("CHILD_RESULT") ? "FINAL_WITH_CHILD_RESULT" : "Background work started.";
+      },
+    });
+    expect(parentCalls).toBe(2);
+    const settled = new Promise<void>(resolve => {
+      const unsubscribe = run!.parentSession.subscribe(event => {
+        if (event.type === "agent_settled") { unsubscribe(); resolve(); }
+      });
+    });
+    child.resolve();
+    await manager().waitForAll();
+    await vi.advanceTimersByTimeAsync(400);
+    await settled;
+
+    expect(parentCalls).toBe(3);
+    expect(notifications(run)).toHaveLength(1);
+    expect(assistantTexts(run).at(-1)).toBe("FINAL_WITH_CHILD_RESULT");
+  });
+
+  it.each(["aborted", "error"] as const)("does not restart a %s parent when a child finishes later", async stopReason => {
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const child = deferred();
+    let parentCalls = 0;
+    run = await runPrintMode({
+      prompt: "Start a background review.",
+      live: false,
+      hold: false,
+      respond: async context => {
+        if (!isParent(context)) { await child.promise; return "CHILD_RESULT"; }
+        parentCalls++;
+        if (spawnedIds(context).length === 0) return agentCall({ prompt: "Review.", description: "review", run_in_background: true });
+        if (parentCalls === 2) return fauxAssistantMessage("Stopped", { stopReason });
+        return "FINAL_WITH_CHILD_RESULT";
+      },
+    });
+    expect(parentCalls).toBe(2);
+    child.resolve();
+    await manager().waitForAll();
+    await vi.advanceTimersByTimeAsync(400);
+
+    expect(parentCalls).toBe(2);
+    expect(notifications(run)).toHaveLength(1);
+    await run.parentSession.prompt("Continue with the result.");
+    expect(parentCalls).toBe(3);
+    expect(assistantTexts(run).at(-1)).toBe("FINAL_WITH_CHILD_RESULT");
+  });
+});
