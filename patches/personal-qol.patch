@@ -0,0 +1,63 @@
+import { describe, expect, it, vi } from "vite-plus/test";
+
+import { sendWorkerMessage } from "./WorkerIpc.ts";
+
+const closedError = (code: string) => Object.assign(new Error("IPC closed"), { code });
+
+describe("snapshot worker IPC teardown", () => {
+  it("exits cleanly when the parent has already disconnected", () => {
+    const worker = { connected: false, send: vi.fn(), exit: vi.fn() };
+    sendWorkerMessage("ready", worker);
+    expect(worker.send).not.toHaveBeenCalled();
+    expect(worker.exit).toHaveBeenCalledWith(0);
+  });
+
+  it.each(["EPIPE", "ECONNRESET", "ERR_IPC_CHANNEL_CLOSED"])(
+    "handles asynchronous %s while a capture result is in flight",
+    (code) => {
+      const exit = vi.fn();
+      let complete: ((error: Error | null) => void) | undefined;
+      sendWorkerMessage(
+        { type: "result", png: "capture" },
+        {
+          connected: true,
+          send: (_message, callback) => {
+            complete = callback;
+            return true;
+          },
+          exit,
+        },
+      );
+      expect(exit).not.toHaveBeenCalled();
+      complete?.(closedError(code));
+      expect(exit).toHaveBeenCalledWith(0);
+    },
+  );
+
+  it("handles a synchronous closed-channel error", () => {
+    const exit = vi.fn();
+    sendWorkerMessage("ready", {
+      connected: true,
+      send: () => {
+        throw closedError("ERR_IPC_CHANNEL_CLOSED");
+      },
+      exit,
+    });
+    expect(exit).toHaveBeenCalledWith(0);
+  });
+
+  it("does not suppress a serialization or programming error", () => {
+    const error = new TypeError("Cannot serialize result");
+    const exit = vi.fn();
+    expect(() =>
+      sendWorkerMessage("ready", {
+        connected: true,
+        send: () => {
+          throw error;
+        },
+        exit,
+      }),
+    ).toThrow(error);
+    expect(exit).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/desktop/src/snapShot/WorkerIpc.ts b/apps/desktop/src/snapShot/WorkerIpc.ts
new file mode 100644
index 000000000..f6309dcb8
--- /dev/null
+++ b/apps/desktop/src/snapShot/WorkerIpc.ts
@@ -0,0 +1,47 @@
+// @effect-diagnostics nodeBuiltinImport:off -- These forked Node workers do not run an Effect runtime.
+import type * as NodeChildProcess from "node:child_process";
+
+type WorkerProcess = {
+  readonly connected?: boolean;
+  readonly send?: (
+    message: NodeChildProcess.Serializable,
+    callback: (error: Error | null) => void,
+  ) => boolean;
+  readonly exit: (code: number) => void;
+};
+
+function isClosedChannelError(error: unknown): boolean {
+  return (
+    error instanceof Error &&
+    "code" in error &&
+    (error.code === "EPIPE" ||
+      error.code === "ECONNRESET" ||
+      error.code === "ERR_IPC_CHANNEL_CLOSED")
+  );
+}
+
+// A parent timeout can close IPC while native capture is still running.
+// A callback handles asynchronous send errors without hiding unrelated failures.
+export function sendWorkerMessage(
+  message: NodeChildProcess.Serializable,
+  worker: WorkerProcess = process,
+): void {
+  if (!worker.send || !worker.connected) {
+    worker.exit(0);
+    return;
+  }
+  const handleError = (error: unknown) => {
+    if (isClosedChannelError(error)) {
+      worker.exit(0);
+      return;
+    }
+    throw error;
+  };
+  try {
+    worker.send(message, (error) => {
+      if (error) handleError(error);
+    });
+  } catch (error) {
+    handleError(error);
+  }
+}
