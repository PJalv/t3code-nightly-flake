+import { describe, expect, it } from "vite-plus/test";
+import { v2FileChangePatch } from "./v2FileChangeDiff";
+
+describe("v2FileChangePatch", () => {
+  it("prefers the original provider patch", () => {
+    expect(v2FileChangePatch({ fileName: "src/a.ts", diffStr: "patch", newStr: "new" })).toBe(
+      "patch",
+    );
+  });
+  it("builds a unified patch from persisted old/new snapshots", () => {
+    expect(v2FileChangePatch({ fileName: "src/a.ts", oldStr: "old\n", newStr: "new\n" })).toContain(
+      "-old\n+new",
+    );
+  });
+  it("preserves missing final newlines on both snapshots", () => {
+    const patch = v2FileChangePatch({ fileName: "src/a.ts", oldStr: "old", newStr: "new" });
+    expect(patch).toContain(
+      "-old\n\\ No newline at end of file\n+new\n\\ No newline at end of file",
+    );
+  });
+  it("uses zero-line ranges for empty-file creation and truncation", () => {
+    expect(v2FileChangePatch({ fileName: "empty.txt", newStr: "" })).toContain("@@ -0,0 +0,0 @@");
+    expect(v2FileChangePatch({ fileName: "empty.txt", oldStr: "old\n", newStr: "" })).toContain(
+      "@@ -1,1 +0,0 @@",
+    );
+  });
+  it("preserves a file containing one blank line", () => {
+    expect(v2FileChangePatch({ fileName: "blank.txt", newStr: "\n" })).toContain(
+      "@@ -0,0 +1,1 @@\n+",
+    );
+  });
+  it("does not infer deletion from a missing new snapshot", () => {
+    expect(v2FileChangePatch({ fileName: "src/a.ts", oldStr: "unchanged\n" })).toBeNull();
+    expect(v2FileChangePatch({ fileName: "src/a.ts" })).toBeNull();
+  });
+});
diff --git a/apps/web/src/components/chat/v2FileChangeDiff.ts b/apps/web/src/components/chat/v2FileChangeDiff.ts
new file mode 100644
index 000000000..5f2284e73
--- /dev/null
+++ b/apps/web/src/components/chat/v2FileChangeDiff.ts
@@ -0,0 +1,42 @@
+export interface V2FileChangeDiffInput {
+  readonly fileName: string;
+  readonly diffStr?: string | undefined;
+  readonly oldStr?: string | undefined;
+  readonly newStr?: string | undefined;
+}
+
+function snapshotLines(text: string): { lines: string[]; hasTrailingNewline: boolean } {
+  const hasTrailingNewline = text.endsWith("\n");
+  const content = hasTrailingNewline ? text.slice(0, -1) : text;
+  return { lines: text === "" ? [] : content.split("\n"), hasTrailingNewline };
+}
+
+/** Prefer the provider patch; otherwise encode both persisted snapshots losslessly. */
+export function v2FileChangePatch(input: V2FileChangeDiffInput): string | null {
+  if (input.diffStr?.trim()) return input.diffStr;
+  if (input.newStr === undefined) return null;
+  const path = input.fileName.replaceAll("\\", "/").replace(/^\/+/, "");
+  const oldExists = input.oldStr !== undefined;
+  const old = snapshotLines(input.oldStr ?? "");
+  const next = snapshotLines(input.newStr ?? "");
+  const range = (start: number, count: number) => `${count ? start : 0},${count}`;
+  const body = [
+    `@@ -${range(1, oldExists ? old.lines.length : 0)} +${range(1, next.lines.length)} @@`,
+    ...(oldExists
+      ? old.lines.flatMap((line, index) => [
+          `-${line}`,
+          ...(index === old.lines.length - 1 && !old.hasTrailingNewline
+            ? ["\\ No newline at end of file"]
+            : []),
+        ])
+      : []),
+    ...next.lines.flatMap((line, index) => [
+      `+${line}`,
+      ...(index === next.lines.length - 1 && !next.hasTrailingNewline
+        ? ["\\ No newline at end of file"]
+        : []),
+    ]),
+  ];
+  const header = oldExists ? `--- a/${path}\n+++ b/${path}` : `--- /dev/null\n+++ b/${path}`;
+  return `${header}\n${body.join("\n")}`;
+}
